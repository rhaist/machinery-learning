---
// Start-page demo: one generation step for three example prompts, with real numbers from a small open model
// (src/data/next-token-probs.json). Behaviour in demos.js.
import { MODEL } from '../scripts/hero-prompts.js';
---
<div class="hero-demo">
  <div class="hd-bar" id="presets"><span class="small">One generation step<span class="w-wide">, shown for three example prompts</span></span><button class="linkbtn small" type="button" id="h-pause" aria-pressed="false">Pause</button></div>
  <div class="pipe" aria-live="off">
    <div class="stage"><h2 class="stage-h">Your text, as tokens</h2><div class="prompt" id="h-prompt"></div><div class="toks" id="h-toks"></div><p class="caption">Each token then becomes a long list of numbers (24 of thousands shown):</p><div class="vecs" id="h-vec"></div></div>
    <div class="stage"><h2 class="stage-h">Through the layers</h2><div class="stack" id="stack"></div></div>
    <div class="stage"><h2 class="stage-h">Next-token probabilities</h2><div class="bars" id="h-out"></div><p class="caption">Real numbers from {MODEL.name}, a small open model. It scores all {MODEL.vocab.toLocaleString('en')} tokens in its vocabulary; these are the most likely.</p></div>
  </div>
</div>
