---
// One drawn banner per chapter, in a shared visual language: belts, blocks (tokens), gears, tracks.
// Colours come from theme variables, so every drawing works in light and dark.
const { name } = Astro.props;
const tone: Record<string, string> = { 'a-b': 'var(--b)', 'a-t': 'var(--t)', 'a-y': 'var(--y)', 'a-r': 'var(--r)' };
// A gear drawn as line art: rim, hub and short teeth, in one stroke colour.
const gear = (cx: number, cy: number, r: number, cls = 'a-c2') => {
  const c = tone[cls] ?? 'color-mix(in srgb,var(--ink) 55%,transparent)';
  const teeth = Array.from({ length: 10 }, (_, i) => { const a = (i * 36 * Math.PI) / 180; const x1 = cx + Math.sin(a) * r, y1 = cy - Math.cos(a) * r, x2 = cx + Math.sin(a) * r * 1.32, y2 = cy - Math.cos(a) * r * 1.32; return `<path d="M${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)}"/>`; }).join('');
  return `<g style="stroke:${c};fill:none;stroke-linecap:round"><g style="stroke-width:${Math.max(3, r * 0.22).toFixed(1)}">${teeth}</g><circle cx="${cx}" cy="${cy}" r="${r}" style="stroke-width:1.75;fill:color-mix(in srgb,${c} 14%,var(--bg))"/><circle cx="${cx}" cy="${cy}" r="${(r * 0.38).toFixed(1)}" style="stroke-width:1.5"/></g>`;
};
const block = (x: number, y: number, label = '', cls = 'a-c2', w = 46, h = 34) =>
  `<g><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="7" class="${cls}"/><rect x="${x}" y="${y}" width="${w}" height="5" rx="2" class="a-hi"/>${label ? `<text x="${x + w / 2}" y="${y + h / 2 + 5}" text-anchor="middle" class="a-tx">${label}</text>` : ''}</g>`;
const belt = (x1: number, x2: number, y: number) =>
  `<g><rect x="${x1}" y="${y}" width="${x2 - x1}" height="12" rx="6" class="a-c3"/>${Array.from({ length: Math.floor((x2 - x1) / 28) }, (_, i) => `<circle cx="${x1 + 14 + i * 28}" cy="${y + 6}" r="3" class="a-bg"/>`).join('')}</g>`;
const ground = `<rect x="0" y="182" width="800" height="38" class="a-s1"/>`;

