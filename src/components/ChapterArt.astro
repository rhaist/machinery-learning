    <rect x="72" y="88" width="36" height="5" rx="2" class="a-ln"/><rect x="72" y="100" width="30" height="5" rx="2" class="a-ln"/><rect x="128" y="84" width="28" height="20" rx="3" class="a-y" opacity=".85"/>
