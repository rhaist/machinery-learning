<div class="panel demo" id="br">
  <div class="row" style="margin-bottom:10px"><span class="small">Presets:</span><button class="btn" type="button" data-br="26,9">OpenAI's 2023 detector (caught 26%, false alarm 9%)</button><button class="btn" type="button" data-br="90,1">A very good detector (90%, 1%)</button></div>
  <div class="ctl"><label for="br-ai">Essays actually written by AI</label><output id="br-ai-o"></output><input type="range" id="br-ai" min="1" max="50" step="1" value="10"></div>
  <div class="ctl"><label for="br-tp">Detector catches AI essays</label><output id="br-tp-o"></output><input type="range" id="br-tp" min="10" max="100" step="1" value="26"></div>
  <div class="ctl"><label for="br-fp">Detector wrongly flags human essays</label><output id="br-fp-o"></output><input type="range" id="br-fp" min="0" max="20" step="0.5" value="9"></div>
  <div class="br-grid" id="br-grid" role="img" aria-label="1,000 essays coloured by detector outcome"></div>
  <div class="legend" style="margin-top:10px"><span style="--c:var(--t)">AI essay caught</span><span style="--c:var(--y)">AI essay missed</span><span style="--c:var(--r)">Human wrongly accused</span><span style="--c:var(--chip2)">Human, not flagged</span></div>
  <p class="lab-verdict" id="br-verdict"></p>
</div>
