---
// Engineer-depth layer: collapsed by default; readers can open each box, or set all to open in the menu (Settings › Engineer boxes).
const { title = 'How it works underneath' } = Astro.props;
---
<details class="eng">
  <summary><span class="eng-tag">Engineer depth</span><span class="eng-title">{title}</span></summary>
  <div class="eng-body"><slot /></div>
</details>
