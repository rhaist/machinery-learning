<div class="panel demo">
  <div class="ctl"><label for="ctx">Context length</label><output id="ctx-o"></output><input type="range" id="ctx" min="0" max="6" step="1" value="4"></div>
  <div class="meter"><span>Attention scores per head, per layer</span><span class="bt"><i id="m1"></i></span><span class="v" id="v1"></span></div>
  <div class="meter"><span>KV cache memory</span><span class="bt"><i id="m2"></i></span><span class="v" id="v2"></span></div>
  <div class="meter"><span>SSM / linear-attention state</span><span class="bt"><i style="width:1%"></i></span><span class="v">fixed</span></div>
  <p class="small" style="margin:6px 0 0">Bars are linear in the 1M-token maximum. Attention work grows with the square of the length; memory grows in a straight line.</p>
</div>
