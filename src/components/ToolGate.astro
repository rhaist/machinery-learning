<div class="panel demo">
  <b>A gate for an agent's commands</b>
  <label for="cmd">Proposed tool call</label>
  <select id="cmd"></select>
  <div class="bars" id="gate"></div>
  <div class="ctl"><label for="thr">Auto-run if P(allow) ≥</label><output id="thr-o">0.90</output><input type="range" id="thr" min="0.5" max="0.99" step="0.01" value="0.9"></div>
  <pre id="pol"></pre>
  <div class="verdict" id="verdict"></div>
  <p class="caption">Illustrative probabilities, not output from a real decision model.</p>
</div>
