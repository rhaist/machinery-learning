---
import '@fontsource/red-hat-display/latin-700.css';
import '@fontsource/red-hat-display/latin-800.css';
import '@fontsource/red-hat-text/latin-400.css';
import '@fontsource/red-hat-text/latin-500.css';
import '@fontsource/red-hat-text/latin-700.css';
import '@fontsource/red-hat-mono/latin-400.css';
import '@fontsource/red-hat-mono/latin-500.css';
import '../styles/global.css';
import { glossary, site } from '../lib/data';
import { getCollection } from 'astro:content';
const { title, description = `${site.tagline}. Interactive, plain-language, updated monthly.`, chapter = '', nav = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = (await getCollection('notes')).sort((a, b) => b.data.month.localeCompare(a.data.month));
const lastUpdate = notes[0]?.data.date;
const links = [['learn', 'Learn', `${base}/learn/start-here/`], ['radar', 'Radar', `${base}/radar/`], ['notes', 'Field notes', `${base}/notes/`], ['glossary', 'Glossary', `${base}/glossary/`], ['about', 'How it works', `${base}/about/`]];
---
<!DOCTYPE html>
<html lang="en" data-depth="beginner">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title === site.name ? `${site.name}: ${site.tagline}` : `${title} · ${site.name}`}</title>
  <meta property="og:title" content={title === site.name ? site.name : `${title} · ${site.name}`}>
  <meta property="og:description" content={description}>
  <meta name="description" content={description}>
  <link rel="alternate" type="application/rss+xml" title={`${site.name}: field notes`} href={`${base}/rss.xml`}>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <script is:inline>try{var d=JSON.parse(localStorage.getItem('lfg-depth')||'"beginner"');document.documentElement.dataset.depth=d;var t=JSON.parse(localStorage.getItem('lfg-theme')||'"auto"');if(t!=="auto")document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body data-chapter={chapter}>
  <header class="site-head"><div class="in">
    <a class="brand" href={`${base}/`}><i></i>{site.name}</a>
    <nav class="site-nav" aria-label="Main">{links.map(([k, label, href]) => <a href={href} aria-current={nav === k ? 'page' : undefined}>{label}</a>)}</nav>
    <button type="button" class="theme-btn" id="theme-btn" aria-label="Colour theme: follows your system" title="Colour theme"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/></svg><span class="theme-label">Auto</span></button>
    <div class="depth"><span>Reading path</span><div class="seg2" role="group" aria-label="Reading path"><button type="button" data-depth-btn="beginner" aria-pressed="true">Beginner</button><button type="button" data-depth-btn="engineer" aria-pressed="false">Engineer</button></div></div>
  </div></header>
  <slot name="top" />
  <main><slot /></main>
  <footer class="site-foot band"><div class="in">
    <span>A living guide, updated monthly{lastUpdate && <> · last update {lastUpdate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</>}</span>
    <span><a href={`${base}/sources/`}>Sources &amp; freshness</a> · <a href={`${base}/rss.xml`}>RSS</a> · <a href={site.repo}>Source on GitHub</a> · <a href={`${base}/impressum/`}>Legal notice</a> · <a href={`${base}/privacy/`}>Privacy</a></span>
  </div></footer>
  <div id="tip" hidden role="tooltip"></div>
  <script type="application/json" id="glossary-data" set:html={JSON.stringify(glossary)} />
  <script>
    import '../scripts/demos.js';
    import '../scripts/site.js';
  </script>
</body>
</html>
