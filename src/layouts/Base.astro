---
import '../styles/global.css';
import { glossary } from '../lib/data';
import { getCollection } from 'astro:content';
const { title, description = 'A living, interactive guide to how large language models work, updated monthly.', chapter = '', nav = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = (await getCollection('notes')).sort((a, b) => b.data.month.localeCompare(a.data.month));
const lastUpdate = notes[0]?.data.date;
const links = [['learn', 'Learn', `${base}/learn/start-here/`], ['radar', 'Radar', `${base}/radar/`], ['notes', 'Field notes', `${base}/notes/`], ['glossary', 'Glossary', `${base}/glossary/`], ['about', 'How it works', `${base}/about/`]];
---
<!DOCTYPE html>
<html lang="en" data-depth="beginner">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title === 'LLM Field Guide' ? title : `${title} · LLM Field Guide`}</title>
  <meta name="description" content={description}>
  <link rel="alternate" type="application/rss+xml" title="LLM Field Guide: field notes" href={`${base}/rss.xml`}>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@700;800&family=Red+Hat+Text:wght@400;500;700&family=Red+Hat+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script is:inline>try{var d=JSON.parse(localStorage.getItem('lfg-depth')||'"beginner"');document.documentElement.dataset.depth=d}catch(e){}</script>
</head>
<body data-chapter={chapter}>
  <header class="site-head"><div class="in">
    <a class="brand" href={`${base}/`}><i></i>LLM Field Guide</a>
    <nav class="site-nav" aria-label="Main">{links.map(([k, label, href]) => <a href={href} aria-current={nav === k ? 'page' : undefined}>{label}</a>)}</nav>
    <div class="depth"><span>Reading path</span><div class="seg2" role="group" aria-label="Reading path"><button type="button" data-depth-btn="beginner" aria-pressed="true">Beginner</button><button type="button" data-depth-btn="engineer" aria-pressed="false">Engineer</button></div></div>
  </div></header>
  <slot name="top" />
  <main><slot /></main>
  <footer class="site-foot band"><div class="in">
    <span>A living guide, updated monthly{lastUpdate && <> · last update {lastUpdate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</>}</span>
    <span><a href={`${base}/sources/`}>Sources &amp; freshness</a> · <a href={`${base}/rss.xml`}>RSS</a> · <a href="https://github.com/rhaist/llm-field-guide">Source on GitHub</a></span>
  </div></footer>
  <div id="tip" hidden role="tooltip"></div>
  <script type="application/json" id="glossary-data" set:html={JSON.stringify(glossary)} />
  <script>
    import '../scripts/demos.js';
    import '../scripts/site.js';
  </script>
</body>
</html>
