---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { monthLabel } from '../../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = (await getCollection('notes')).sort((a, b) => b.data.month.localeCompare(a.data.month));
---
<Base title="Field notes" description="Monthly notes on what changed in how LLMs work and how to use them." nav="notes">
  <section class="band"><div class="page-text">
    <header class="page-head"><h1>Field notes</h1>
    <p class="lede">Once a month: what changed in the field, and whether it should change how you understand or use these systems. A note also lists any fact in the guide that turned out to be wrong and was fixed. Subscribe via <a href={`${base}/rss.xml`}>RSS</a>.</p></header>
    <div class="notes-list">{notes.map(n => <a class="card" href={`${base}/notes/${n.id}/`}><span class="small">{monthLabel(n.data.month)}{n.data.corrections.length > 0 && ` · ${n.data.corrections.length} ${n.data.corrections.length === 1 ? 'correction' : 'corrections'}`}</span><h2 class="card-h">{n.data.title}</h2><p>{n.data.summary}</p></a>)}</div>
  </div></section>
</Base>
