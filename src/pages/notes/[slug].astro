---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { monthLabel } from '../../lib/data';
export async function getStaticPaths() {
  return (await getCollection('notes')).map(n => ({ params: { slug: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
---
<Base title={n.data.title} description={n.data.summary} nav="notes">
  <article class="band"><div class="chapter">
    <header class="chapter-head"><div class="kicker">Field notes · {monthLabel(n.data.month)}</div><h1>{n.data.title}</h1><p class="lede" style="margin-top:14px">{n.data.summary}</p></header>
    <div class="prose"><Content /></div>
  </div></article>
</Base>
