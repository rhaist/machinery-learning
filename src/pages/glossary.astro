---
import Base from '../layouts/Base.astro';
import { glossary } from '../lib/data';
const items = Object.entries(glossary).sort((a, b) => a[1].term.localeCompare(b[1].term));
---
<Base title="Glossary" description="Plain-language definitions of LLM jargon." nav="glossary">
  <section class="band"><div class="wrap">
    <header class="page-head"><h1>Glossary</h1>
    <p class="lede">Every dotted term in the guide, in plain language. {items.length} terms.</p></header>
    <div class="gl-search"><label for="gq" class="small">Search all terms</label><input type="search" id="gq" placeholder="e.g. cache, RLHF, router"></div>
    <dl class="gl">{items.map(([k, v]) => <div class="gi" id={`g-${k}`} data-s={(v.term + ' ' + v.def).toLowerCase()}><dt>{v.term}</dt><dd>{v.def}</dd></div>)}</dl>
  </div></section>
</Base>
