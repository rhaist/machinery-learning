---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroPipeline from '../components/HeroPipeline.astro';
import { radarEntries, radarMonths, ringAt, monthLabel, site, edition, byPart } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const parts = byPart(chapters);
const notes = (await getCollection('notes')).sort((a, b) => b.data.month.localeCompare(a.data.month));
const latest = notes[0];
const month = radarMonths[radarMonths.length - 1];
const count = (r: string) => radarEntries.filter(e => ringAt(e, month) === r).length;
const mins = (p: any) => p.chapters.reduce((t: number, { c }: any) => t + c.data.minutes, 0);
const dur = (m: number) => m < 75 ? `about ${Math.round(m / 15) * 15 >= 60 ? 'an hour' : Math.round(m / 5) * 5 + ' minutes'}` : `about ${(Math.round(m / 30) / 2).toString().replace('.5', '½')} hours`;
const first = parts[0].chapters[0].c;
const pi = parts.flatMap((p: any) => p.chapters).map(({ c }: any) => c).find((c: any) => c.id === 'prompt-injection');
---
<Base title={site.name} nav="">
  <section class="band home-hero"><div class="wrap">
    <div class="htop">
      <div class="hero-copy">
        <p class="kicker">{monthLabel(String(edition.month))} edition · {edition.subtitle}</p>
        <h1>How AI like ChatGPT works, updated every month</h1>
        <div class="hero-cta">
          <a class="btn pri" id="hero-start" href={`${base}/learn/${first.id}/`}>Start reading</a>
          <p class="hero-meta" id="hero-meta">Chapter 0 · {first.data.minutes} minutes · nothing to sign up for</p>
          {pi && <p class="hero-alt">Here for security? Skip ahead to <a href={`${base}/learn/${pi.id}/`}>prompt injection</a>: why a stranger's email can take over your assistant. {pi.data.minutes} minutes, no earlier chapters needed.</p>}
        </div>
      </div>
      <div class="hero-side">
        <p class="lede">Most of us use AI tools every day without knowing what happens between typing a question and getting an answer. This guide explains it from the ground up, in plain language and with diagrams you can try. The boxes marked Engineer hold the technical detail for anyone who wants it. The field changes every month, so every fast-moving fact shows when it was last checked.</p>
        <nav class="hero-map" aria-label="The whole guide at a glance">
          {parts.map(p => <div class="hm-part">
            <p class="label">{p.title.replace(':', ' ·')} · {p.chapters.length} {p.chapters.length === 1 ? "chapter" : "chapters"} · {dur(mins(p))}</p>
            <ol class="hm-dots">{p.chapters.map(({ c, num }) => <li data-chapter-link={c.id}><a href={`${base}/learn/${c.id}/`} title={c.data.title} aria-label={`Chapter ${num}: ${c.data.title}`}>{num}</a></li>)}</ol>
          </div>)}
          <p class="hm-key small"><span class="hm-sw next"></span><span id="hm-key-next">start here</span><span class="hm-sw done"></span>finished</p>
        </nav>
      </div>
    </div>
    <p class="since" id="since" hidden>Welcome back: <b></b> since your last visit, highlighted in yellow.</p>
    <HeroPipeline />
  </div></section>

  {parts.map((p, pi) => (
  <section class={`band ${pi % 2 ? '' : 'alt'}`}><div class="wrap">
    <div class="part-head"><h2>{p.title}</h2>
    <p>{p.summary}{pi === 0 && " Start at zero if you're new; jump around if you're not."}</p></div>
    <ol class="route" aria-label={`Your route through ${p.title}`}>
      {p.chapters.map(({ c, num }) => (
        <li data-chapter-link={c.id}><a href={`${base}/learn/${c.id}/`}><span class="st">{num}</span><span class="lb">{c.data.short}</span></a></li>
      ))}
    </ol>
    {pi === 0 && <p class="continue" id="continue" hidden><a class="btn pri" href="#">Continue</a> <span class="small" id="continue-note"></span></p>}
    <div class="journey">
      {p.chapters.map(({ c, num }) => (
        <a class="card" href={`${base}/learn/${c.id}/`} data-chapter-link={c.id} data-updated={c.data.updated.toISOString().slice(0, 10)}>
          <span class="num">{num}</span><span class="newtag">updated</span>
          <h3>{c.data.title}</h3>
          <p>{c.data.summary}</p>
          <div class="cm">{c.data.minutes} min</div>
        </a>
      ))}
    </div>
  </div></section>
  ))}

  <section class={`band ${parts.length % 2 ? '' : 'alt'}`}><div class="wrap">
    <div class="part-head"><h2>This month in the field</h2></div>
    <div class="month">
      {latest && <a class="card" href={`${base}/notes/${latest.id}/`} data-updated={latest.data.date.toISOString().slice(0, 10)}>
        <span class="small">Field notes · {monthLabel(latest.data.month)}</span><span class="newtag">new</span>
        <h3>{latest.data.title}</h3><p>{latest.data.summary}</p>
      </a>}
      <a class="card" href={`${base}/radar/`}>
        <span class="small">Frontier radar · {monthLabel(month)}</span>
        <h3>{radarEntries.length} directions tracked</h3>
        <p>{count('shipping')} shipping, {count('emerging')} emerging, {count('research')} still in research. See what moved this month and why it matters.</p>
      </a>
    </div>
  </div></section>
</Base>
