---
import Base from '../layouts/Base.astro';
import { radarEntries, radarMonths, quadrants, monthLabel } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const data = { months: radarMonths, quadrants, entries: radarEntries };
---
<Base title="Frontier radar" description="Where research directions in AI stand this month, from research to shipping." nav="radar" og="radar">
  <section class="band"><div class="wrap">
    <header class="page-head"><h1>Frontier radar</h1>
    <p class="lede">Where each research direction and practice stands, from <b>research</b> (papers and prototypes) through <b>emerging</b> (first real releases, claims still contested) to <b>shipping</b> (in products people use). Positions are reviewed every month; history is never rewritten.</p></header>
    <div class="radar-wrap">
      <div class="radar-col">
        <div class="radar-fig"><svg id="radar" role="group" aria-label="Radar of AI research directions by maturity; each numbered dot matches an entry in the list"></svg></div>
        <div class="legend" aria-label="Ring colours"><span style="--c:var(--t)">Shipping</span><span style="--c:var(--y)">Emerging</span><span style="--c:var(--bsoft)">Research</span><span style="--c:var(--faint)">Faded</span></div>
        {radarMonths.length > 1
          ? <div class="ctl"><label for="radar-month">Replay history</label><output id="radar-month-label"></output><input type="range" id="radar-month" min="0" step="1"></div>
          : <p class="caption">History starts in <span id="radar-month-label">{monthLabel(radarMonths[0])}</span>. From next month on, a slider here replays how entries moved.</p>}
      </div>
      <div>
        {quadrants.map(q => <>
          <div class="qhead">{q}</div>
          <ul class="rlist">{radarEntries.map((e, i) => [e, i] as const).filter(([e]) => e.quadrant === q).map(([e, i]) =>
            <li data-entry={e.id} id={`r-${e.id}`}><span class="no">{i + 1}</span><b>{e.name}</b><span class="ring"></span><p>{e.note}{e.chapter && <> <a href={`${base}/learn/${e.chapter}/`}>Read more</a></>}</p></li>)}
          </ul>
        </>)}
      </div>
    </div>
  </div></section>
  <script type="application/json" id="radar-data" set:html={JSON.stringify(data)} />
</Base>
