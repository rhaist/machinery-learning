---
import Base from '../layouts/Base.astro';
import { corrections, site, reportUrl } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const who: Record<string, string> = { reader: 'Reported by a reader', 'fact-check': 'Found in an independent fact-check', 'monthly review': 'Found in the monthly review', editor: 'Found by the editor' };
---
<Base title="Corrections" description="Every factual correction made to the guide, with what was wrong and what it says now." nav="about">
  <section class="band"><div class="wrap">
    <header class="page-head"><h1>Corrections</h1>
    <p class="lede">Every factual correction since the guide launched is listed here: what it said, what it says now, and how the error was found. Rewording and new material aren't listed. If you spot something wrong, <a href={reportUrl(site.repo, { title: 'page or chapter', page: 'https://' + site.domain + '/' })}>report it on GitHub</a>.</p></header>
    {corrections.length === 0 ? <p>No corrections yet.</p> :
    <ol class="corr">
      {corrections.map(c => <li>
        <p class="label">{fmt(c.date)} · {who[c.found_by] ?? c.found_by}</p>
        <h2><a href={`${base}${c.page}`}>{c.title}</a></h2>
        <p><b>Was:</b> {c.what}</p>
        <p><b>Now:</b> {c.now}</p>
      </li>)}
    </ol>}
  </div></section>
</Base>
